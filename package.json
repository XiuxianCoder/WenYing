{
  "name": "wenying-desktop",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "文映 WenYing - AI 图文写作、排版与微信公众号发布桌面应用",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env WENYING_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build:web": "vite build",
    "build": "npm run build:web && electron-builder --dir",
    "dist": "npm run build:web && electron-builder",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.wenying.desktop",
    "productName": "文映 WenYing",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "wenying",
        "to": "python/wenying",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "wenying_bridge.py",
        "to": "python/wenying_bridge.py"
      },
      {
        "from": "data/wenying.ico",
        "to": "data/wenying.ico"
      },
      {
        "from": "data/wenying-icon.png",
        "to": "data/wenying-icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "data/wenying.ico",
      "artifactName": "WenYing-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  }
}
